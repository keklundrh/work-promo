# Copy to .env (gitignored) and fill in. Compose reads this file automatically.
# In-cluster, these three LLM_* values become an OpenShift Secret mounted as env.

# LLM endpoint (spec #3): model, URI, key
LLM_BASE_URL=http://mock-llm:9999/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen2.5-32b-instruct

# Local dev identity (stand-in for the OpenShift OAuth proxy header)
LOCAL_USER=karl

# Postgres (defaults match compose). Password only takes effect before the
# first `up` initializes the volume; changing it later desyncs app and db.
POSTGRES_PASSWORD=workpromo
